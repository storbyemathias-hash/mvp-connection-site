---
/** Dark iPhone-style mockup that plays the missed-call text-back flow. Example only. */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const msgs = [
  { from: 'us', text: "Hi, it's ABC Plumbing. Sorry we missed your call! What can we help with?", meta: 'Sent automatically · 4 sec after the call' },
  { from: 'them', text: 'Water heater is leaking in the garage. Can someone come today?' },
  { from: 'us', text: 'Got it. We can be there between 2 and 4 today. Does that work?', meta: 'You, from your phone' },
  { from: 'them', text: 'Yes please. Thank you!' },
];
---
<figure class={`phone-demo relative mx-auto w-[18.5rem] ${cls}`} data-phone-demo aria-label="Example: a missed call gets a text back and turns into a booked job">
  <div class="relative rounded-[3rem] p-[0.6rem]" style="background:linear-gradient(145deg,#3a3a3e,#111113 40%,#2a2a2d);box-shadow:inset 0 0 0 1px rgb(255 255 255/.12),0 50px 100px -30px rgb(0 0 0/.95),0 0 80px -20px rgb(255 255 255/.1)">
    <div class="relative overflow-hidden rounded-[2.5rem] bg-[#000]">
      <div class="relative flex items-center justify-between px-7 pt-3.5 text-[0.75rem] font-semibold">
        <span>9:41</span>
        <span class="absolute left-1/2 top-2.5 h-[1.6rem] w-[5.6rem] -translate-x-1/2 rounded-full bg-[#000] shadow-[inset_0_0_0_1px_#1a1a1a]"></span>
        <span class="flex items-center gap-1 text-text/80">
          <svg class="h-3 w-4" viewBox="0 0 18 12" fill="currentColor" aria-hidden="true"><rect x="0" y="8" width="3" height="4" rx="1"/><rect x="5" y="5" width="3" height="7" rx="1"/><rect x="10" y="2" width="3" height="10" rx="1"/><rect x="15" y="0" width="3" height="12" rx="1" opacity=".4"/></svg>
          <i class="block h-3 w-6 rounded-[4px] border border-current p-[1px]"><i class="block h-full w-3/4 rounded-[2px] bg-current"></i></i>
        </span>
      </div>
      <div class="border-b border-white/[.07] px-4 pb-3 pt-5 text-center">
        <div class="mx-auto grid h-11 w-11 place-items-center rounded-full bg-gradient-to-b from-[#5a5a60] to-[#2e2e32] text-[0.8rem] font-semibold">JR</div>
        <p class="mt-1.5 text-[0.78rem] font-medium">(555) 010-0142</p>
      </div>
      <div class="flex min-h-[27rem] flex-col gap-2.5 px-3 py-4 text-[0.84rem] leading-snug" data-thread>
        <div class="pd-item flex justify-center" data-step="0">
          <span class="chip chip-miss">
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/><path d="m16 3 5 5m0-5-5 5"/></svg>
            Missed call · 2:14 PM
          </span>
        </div>
        {msgs.map((m) => (
          <div class={`pd-item flex flex-col ${m.from === 'us' ? 'items-end' : 'items-start'}`}>
            <p class={`max-w-[84%] rounded-[1.15rem] px-3.5 py-2 ${m.from === 'us' ? 'rounded-br-md bg-[#e9e9eb] text-[#0a0a0a]' : 'rounded-bl-md bg-[#1f1f22] text-text'}`}>{m.text}</p>
            {m.meta && <span class="mt-1 px-1 text-[0.66rem] text-dim">{m.meta}</span>}
          </div>
        ))}
        <div class="pd-item mt-auto flex justify-center">
          <span class="chip chip-ok">
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg>
            Job booked
          </span>
        </div>
        <div class="pd-typing hidden items-center gap-1 self-start rounded-full bg-[#1f1f22] px-3 py-2.5" aria-hidden="true"><i></i><i></i><i></i></div>
      </div>
      <div class="mx-auto mb-2 h-1 w-28 rounded-full bg-white/70"></div>
    </div>
  </div>
</figure>

<style>
  .pd-item { opacity: 0; transform: translateY(10px) scale(.97); transition: opacity .45s ease, transform .5s cubic-bezier(.2,.8,.2,1); }
  .pd-item.on { opacity: 1; transform: none; }
  .pd-typing i { width: 6px; height: 6px; border-radius: 50%; background: #8a8a90; animation: pd-dot 1s infinite; }
  .pd-typing i:nth-child(2) { animation-delay: .15s; } .pd-typing i:nth-child(3) { animation-delay: .3s; }
  @keyframes pd-dot { 0%, 60%, 100% { opacity: .3; } 30% { opacity: 1; transform: translateY(-2px); } }
  @media (prefers-reduced-motion: reduce) { .pd-item { opacity: 1; transform: none; transition: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-phone-demo]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>('.pd-item')];
    const typing = root.querySelector<HTMLElement>('.pd-typing')!;
    const thread = root.querySelector<HTMLElement>('[data-thread]')!;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { items.forEach((i) => i.classList.add('on')); return; }
    // One loop per phone; it simply pauses while the phone is off screen.
    const gaps = [600, 1200, 2000, 1900, 1500, 1200];
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let visible = false, started = false;
    const whenVisible = async () => { while (!visible) await sleep(250); };
    const loop = async () => {
      for (;;) {
        items.forEach((i) => i.classList.remove('on'));
        for (let i = 0; i < items.length; i++) {
          const item = items[i];
          const isReply = item.classList.contains('items-start');
          await sleep((gaps[i] ?? 1200) - (isReply ? 900 : 0));
          await whenVisible();
          if (isReply) { thread.insertBefore(typing, item); typing.style.display = 'flex'; await sleep(900); typing.style.display = 'none'; }
          item.classList.add('on');
        }
        await sleep(5000);
        await whenVisible();
      }
    };
    new IntersectionObserver((entries) => {
      visible = entries[entries.length - 1].isIntersecting;
      if (visible && !started) { started = true; loop(); }
    }, { threshold: 0.2 }).observe(root);
  });
</script>
